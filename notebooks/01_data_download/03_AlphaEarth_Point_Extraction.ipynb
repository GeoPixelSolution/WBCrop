      "  started: AE_2023_south_24_parganas           1,370 points\n",
      "  started: AE_2023_uttar_dinajpur              5,008 points\n",
      "  started: AE_2024_alipurduar                    831 points\n",
      "  started: AE_2024_bankura                     2,617 points\n",
      "  started: AE_2024_birbhum                     4,265 points\n",
      "  started: AE_2024_dakshin_dinajpur              723 points\n",
      "  started: AE_2024_darjiling                   4,435 points\n",
      "  started: AE_2024_haora                       1,447 points\n",
      "  started: AE_2024_hugli                       1,524 points\n",
      "  started: AE_2024_jalpaiguri                  2,072 points\n",
      "  started: AE_2024_jhargram                    1,254 points\n",
      "  started: AE_2024_koch_bihar                  5,017 points\n",
      "  started: AE_2024_maldah                      1,737 points\n",
      "  started: AE_2024_murshidabad                 7,416 points\n",
      "  started: AE_2024_nadia                      11,310 points\n",
      "  started: AE_2024_north_24_parganas           3,205 points\n",
      "  started: AE_2024_paschim_barddhaman            653 points\n",
      "  started: AE_2024_pashchim_medinipur          9,122 points\n",
      "  started: AE_2024_purba_barddhaman            2,603 points\n",
      "  started: AE_2024_purba_medinipur             6,685 points\n",
      "  started: AE_2024_puruliya                    1,057 points\n",
      "  started: AE_2024_south_24_parganas           1,370 points\n",
      "  started: AE_2024_uttar_dinajpur              5,008 points\n",
      "\n",
      "42 tasks (2 years x 21 districts).\n",
      "Monitor: https://code.earthengine.google.com/tasks\n",
      "Annual embeddings are a single mosaic, so these are far lighter than the S2 tasks.\n"
     ]
    }
   ],
   "source": [
    "tasks = []\n",
    "\n",
    "# District names come from the ASSET. A case/spacing difference against the local table would\n",
    "# make ee.Filter.eq() return nothing \u2014 the task would succeed and write an empty CSV silently.\n",
    "hist   = fc.aggregate_histogram('district').getInfo()\n",
    "counts = {k: int(v) for k, v in hist.items() if k}\n",
    "districts = sorted(counts)\n",
    "print(f\"{len(districts)} districts | {sum(counts.values()):,} points\\n\")\n",
    "\n",
    "for year in YEARS:\n",
    "    # Filter to the year then mosaic, once per year (kept off the per-task path).\n",
    "    img = col.filterDate(f'{year}-01-01', f'{year+1}-01-01').mosaic()\n",
    "    for d in districts:\n",
    "        sub = fc.filter(ee.Filter.eq('district', d))\n",
    "        sampled = img.sampleRegions(collection=sub, properties=['id'],\n",
    "                                    scale=10, geometries=False, tileScale=16)\n",
    "        name = f'AE_{year}_{d.replace(\" \", \"_\")}'\n",
    "        t = ee.batch.Export.table.toDrive(\n",
    "            collection=sampled, description=name,\n",
    "            folder=EXPORT_FOLDER, fileFormat='CSV')\n",
    "        t.start()\n",
    "        tasks.append((name, t))\n",
    "        print(f\"  started: {name:<34} {counts[d]:>6,} points\")\n",
    "\n",
    "print(f\"\\n{len(tasks)} tasks ({len(YEARS)} years x {len(districts)} districts).\")\n",
    "print(\"Monitor: https://code.earthengine.google.com/tasks\")\n",
    "print(\"Annual embeddings are a single mosaic, so these are far lighter than the S2 tasks.\")"
   ]
  },
