    "## Collect the exports"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "0yW3QpZ8opfT",
    "executionInfo": {
     "status": "ok",
     "timestamp": 1789252448728,
     "user_tz": -330,
     "elapsed": 28785,
     "user": {
      "displayName": "Manas Utthasini",
      "userId": "13698950339272416497"
     }
    },
    "outputId": "3f9366dc-b1ef-4d75-bdec-b6ec3cc0b00c"
   },
   "execution_count": 9,
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "2023: (74351, 65) from 21 files\n",
      "2024: (74351, 65) from 21 files\n"
     ]
    }
   ],
   "source": [
    "csv_dir = f'/content/drive/MyDrive/{EXPORT_FOLDER}'\n",
    "frames = {}\n",
    "for year in YEARS:\n",
    "    files = sorted(glob.glob(f'{csv_dir}/AE_{year}_*.csv'))\n",
    "    if not files:\n",
    "        print(f\"{year}: no CSVs yet \u2014 wait for the tasks to finish.\")\n",
    "        continue\n",
    "    df = pd.concat([pd.read_csv(f) for f in files], ignore_index=True)\n",
    "    df = df.drop(columns=['system:index', '.geo'], errors='ignore')\n",
    "    df = df.rename(columns={b: f'{b}_{year}' for b in BAND_NAMES})\n",
    "    frames[year] = df\n",
    "    print(f\"{year}: {df.shape} from {len(files)} files\")"
   ]
  },
