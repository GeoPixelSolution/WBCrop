   "source": [
    "if frames:\n",
    "    ae = None\n",
    "    for year, df in frames.items():\n",
    "        cols = ['id'] + [c for c in df.columns if c.endswith(f'_{year}')]\n",
    "        ae = df[cols] if ae is None else ae.merge(df[cols], on='id', how='outer')\n",
    "\n",
    "    print(\"Combined:\", ae.shape)\n",
    "    print(\"Points requested:\", f\"{len(pts):,}\", \"| returned:\", f\"{ae['id'].nunique():,}\")\n",
    "    lost = len(pts) - ae['id'].nunique()\n",
    "    print(\"Lost:\", f\"{lost:,}\", f\"({lost/len(pts):.2%})\",\n",
    "          \"\u2014 sampleRegions drops points that return nothing, silently\")\n",
    "\n",
    "    assert ae['id'].is_unique, \"duplicate ids in the sampled output\"\n",
    "\n",
    "    # Loss must not track the class (crop comes from the points table itself).\n",
    "    rec = pd.DataFrame({\n",
    "        'input':    pts.groupby('crop').size(),\n",
    "        'returned': pts[pts['id'].isin(set(ae['id']))].groupby('crop').size(),\n",
    "    }).fillna(0).astype(int)\n",
    "    rec['loss_%'] = ((rec['input'] - rec['returned']) / rec['input'] * 100).round(2)\n",
    "    print(\"\\n\" + rec.sort_values('loss_%', ascending=False).head(8).to_string())\n",
    "    spread = float(rec['loss_%'].max() - rec['loss_%'].min())\n",
    "    print(f\"\\nSpread across classes: {spread:.2f} pp\")\n",
    "    print(\"*** NON-RANDOM LOSS ***\" if spread > 5 else \"Loss is uniform across classes.\")\n",
    "\n",
    "    out = f'{DIR_FEATURES}/AlphaEarth/alphaearth_{\"_\".join(map(str, YEARS))}_features.parquet'\n",
    "    ae.to_parquet(out, index=False)\n",
    "    print(\"Saved:\", out)"
   ]
  },
