  {
   "cell_type": "code",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "bSDlyRNRopfR",
    "executionInfo": {
     "status": "ok",
     "timestamp": 1789251905435,
     "user_tz": -330,
     "elapsed": 2282,
     "user": {
      "displayName": "Manas Utthasini",
