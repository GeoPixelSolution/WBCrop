     }
    },
    "outputId": "862d86d5-2824-4cd2-a06a-3350ce146569"
   },
   "execution_count": 4,
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "64 bands: ['A00', 'A01', 'A02', 'A03', 'A04', 'A05', 'A06', 'A07'] ...\n",
      "Projection: EPSG:32603 | nominal scale: 10 m\n"
     ]
    }
   ],
   "source": [
    "col   = ee.ImageCollection('GOOGLE/SATELLITE_EMBEDDING/V1/ANNUAL')\n",
    "probe = col.filterDate('2024-01-01', '2025-01-01').first()\n",
    "BAND_NAMES = probe.bandNames().getInfo()\n",
    "print(f\"{len(BAND_NAMES)} bands:\", BAND_NAMES[:8], \"...\")\n",
    "print(\"Projection:\", probe.projection().getInfo().get('crs'),\n",
    "      \"| nominal scale:\", probe.projection().nominalScale().getInfo(), \"m\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "2Wlg7q5uopfR"
   },
   "source": "## Points, and the survey-year check\n\nAn embedding year mismatched to `collection_date` mislabels annual crops (rice, jute, potato); perennials are unaffected."
  },
  {
   "cell_type": "code",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "x8RvGFtnopfS",
    "executionInfo": {
     "status": "ok",
     "timestamp": 1789251948393,
     "user_tz": -330,
     "elapsed": 7913,
     "user": {
      "displayName": "Manas Utthasini",
      "userId": "13698950339272416497"
     }
    },
    "outputId": "4448cdce-3e72-4f34-b13a-a4ec1eee51c8"
   },
   "execution_count": 5,
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Local points: 74,351\n",
      "\n",
      "Survey-year distribution:\n",
      "survey_year\n",
      "2023    34965\n",
      "2024    39386\n",
      "\n",
      "Points whose survey year is NOT in [2023, 2024]: 0 (0.0%)\n",
      "For those, an annual-crop label may not match either embedding year. Perennials are fine.\n",
      "\n",
      "Asset points: 74,351 | properties: ['collection_date', 'harvest', 'sowing', 'district', 'season', 'id', 'state', 'source', 'pheno_stage', 'crop', 'system:index']\n",
      "Asset matches the local table.\n"
     ]
    }
   ],
   "source": [
    "pts = gpd.read_file(POINTS_GPKG, layer=POINTS_LAYER)\n",
    "assert pts['id'].is_unique, \"duplicate ids in the points file\"\n",
    "print(f\"Local points: {len(pts):,}\")\n",
    "\n",
    "# Survey year from collection_date\n",
    "pts['survey_year'] = pd.to_datetime(pts['collection_date'], errors='coerce').dt.year\n",
    "print(\"\\nSurvey-year distribution:\")\n",
    "print(pts['survey_year'].value_counts(dropna=False).sort_index().to_string())\n",
    "\n",
    "off = pts[~pts['survey_year'].isin(YEARS)]\n",
    "print(f\"\\nPoints whose survey year is NOT in {YEARS}: {len(off):,} ({len(off)/len(pts):.1%})\")\n",
    "print(\"For those, an annual-crop label may not match either embedding year. Perennials are fine.\")\n",
    "\n",
    "# Compare against the EE asset\n",
    "fc = ee.FeatureCollection(POINTS_ASSET)\n",
    "n_asset = fc.size().getInfo()\n",
    "print(\"\\nAsset points:\", f\"{n_asset:,}\", \"| properties:\", fc.first().propertyNames().getInfo())\n",
    "if n_asset != len(pts):\n",
    "    print(f\"*** MISMATCH of {abs(n_asset - len(pts)):,} features \u2014 re-check the upload.\")\n",
    "else:\n",
    "    print(\"Asset matches the local table.\")"
   ]
  },
