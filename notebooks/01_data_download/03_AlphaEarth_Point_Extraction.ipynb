    "import os, glob, json, time\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import geopandas as gpd\n",
    "import ee\n",
    "\n",
    "from google.colab import drive\n",
    "drive.mount('/content/drive')\n",
    "\n",
    "ROOT         = '/content/drive/MyDrive/Crop_Classification'\n",
    "DIR_POINTS   = f'{ROOT}/01_Points'\n",
    "DIR_FEATURES = f'{ROOT}/02_RawTimeSeries'\n",
    "DIR_QA       = f'{ROOT}/05_QA'\n",
    "os.makedirs(f'{DIR_FEATURES}/AlphaEarth', exist_ok=True)\n",
    "\n",
    "# Your actual points file.\n",
    "POINTS_GPKG  = f'{DIR_POINTS}/wbcrop_points_extended.gpkg'\n",
    "POINTS_LAYER = 'wbcrop_points_extended'"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "p6uc3JOeopfP"
   },
   "source": [
    "## Configuration\n",
    "\n",
    "AlphaEarth embeddings are **calendar-annual**; your window is 2023-01 to 2024-12. No single\n",
    "year matches a growing season, so extract both 2023 and 2024 and let the model use both.\n",
    "State the calendar-vs-agricultural-year point in the methods rather than hiding it."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
    "id": "OVP5l9QropfQ",
    "executionInfo": {
     "status": "ok",
     "timestamp": 1789251898306,
     "user_tz": -330,
     "elapsed": 16847,
     "user": {
      "displayName": "Manas Utthasini",
      "userId": "13698950339272416497"
     }
    }
   },
   "execution_count": 3,
   "outputs": [],
   "source": [
    "EE_PROJECT    = 'ee-geographymanas'\n",
    "EXPORT_FOLDER = 'CropClass_AlphaEarth'\n",
    "\n",
    "YEARS = [2023, 2024]\n",
    "\n",
    "# CSV asset (full field names, integer id) \u2014 same asset used by the S2 run.\n",
    "POINTS_ASSET = 'projects/ee-geographymanas/assets/WestBengal/wbcrop_points_extended'\n",
    "\n",
    "ee.Authenticate()\n",
    "ee.Initialize(project=EE_PROJECT)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "-Jn904JfopfQ"
   },
   "source": "## Verify the collection\n\nRead band names from the collection rather than assuming."
